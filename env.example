# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_NAME=TelegramCommentBot

# Telegram API Credentials (from https://my.telegram.org/apps)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Admin Password (for bot authentication)
PASSWORD=your_admin_password_here

# OpenAI API Key (for comment generation)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# Option 1: Full PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual database settings (used if DATABASE_URL is not set)
DB_NAME=pgbot1010
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Directories
SESSIONS_DIR=sessions
LOGS_DIR=logs
DATA_DIR=data

# Log Channel ID (for notifications)
LOG_CHANNEL_ID=-1003123025616

# Warmup Settings (optional, defaults will be used if not set)
WARMUP_VERBOSE_LOGS=false
WARMUP_VERBOSE_NOTIFICATIONS=false

# Reaction Settings (optional)
REACTION_LIMIT_PER_MESSAGE=1
REACTION_MIN_INTERVAL_SECONDS=10

