# Default environment configuration for the Telegram warmup bot
# Copy this file to `.env` and adjust the values for your environment.

# ---------------------------------------------------------------------------
# Core bot credentials
# ---------------------------------------------------------------------------
BOT_TOKEN=your_bot_token
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
OPENAI_API_KEY=sk-your-openai-key
PASSWORD=change_me
LOG_CHANNEL_ID=0

# ---------------------------------------------------------------------------
# Database configuration
# ---------------------------------------------------------------------------
DATABASE_NAME=pgbot1010
DATABASE_USER=pgbot1010_user
DATABASE_PASSWORD=pgbot1010_password
DATABASE_HOST=postgres
DATABASE_PORT=5432
# The URL is derived automatically when the variables above are present, but
# can be overridden explicitly if needed.
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
# Optional superuser connection string used for provisioning (user/database
# creation) and automated migrations. Leave empty to disable provisioning.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@postgres:5432/postgres
# Directory where automatic pre-migration backups should be stored. Set to an
# empty string to disable backups.
DATABASE_BACKUP_DIR=backups

# Legacy variables used by older docker-compose stacks (safe to remove when the
# new DATABASE_* variables are in use).
PROJECT_NAME=telegram_bot
POSTGRES_DB=${DATABASE_NAME}
POSTGRES_USER=${DATABASE_USER}
POSTGRES_PASSWORD=${DATABASE_PASSWORD}
POSTGRES_PORT=${DATABASE_PORT}

# Miscellaneous flags
WARMUP_VERBOSE_LOGS=0
WARMUP_VERBOSE_NOTIFICATIONS=0
